{
  "format": "ambrotype-layout/1",
  "name": "Retouch",
  "description": "Retouch: its own tools on the left (Remove object, AI Remove, Heal, Find dust, and the Subject, People, Background and Sky masks), with Detail open and Texture and Clarity as knobs for skin on the right.",
  "author": "Ambrotype",
  "density": "normal",
  "toolbar": ["open", "save", "export", "|", "undo", "redo", "|", "auto", "select", "search", "|", "before", "masks", "spots", "zoom", "crop", "wb", "|", "plugins", "|", "looks", "settings"],
  "left": { "width": 270, "items": ["retouch", "history", "presets"] },
  "right": {
    "width": 330,
    "items": [
      "histogram",
      {
        "title": "Skin and finish",
        "open": true,
        "columns": 3,
        "items": [
          { "setting": "Texture", "widget": "knob" },
          { "setting": "Clarity2012", "widget": "knob", "label": "Clarity" },
          { "setting": "Dehaze", "widget": "knob" }
        ]
      },
      { "panel": "basic", "open": true, "hide": ["Texture", "Clarity2012", "Dehaze"] },
      { "panel": "detail", "open": true },
      { "panel": "color_mixer" },
      { "panel": "tone_curve" },
      { "panel": "color_grading" },
      { "panel": "effects" },
      { "panel": "lens" },
      { "panel": "transform" },
      { "panel": "black_white" },
      { "panel": "calibration" },
      { "panel": "negative" }
    ]
  }
}

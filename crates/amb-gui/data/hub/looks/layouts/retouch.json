{
  "format": "ambrotype-layout/1",
  "name": "Retouch",
  "description": "For portraits and clean-up: masks, spot removal and the 100% view up front, Detail open for sharpening and noise, and Texture and Clarity as knobs for skin.",
  "author": "Ambrotype",
  "density": "normal",
  "toolbar": ["open", "save", "export", "|", "undo", "redo", "|", "before", "masks", "spots", "zoom", "crop", "wb", "|", "plugins", "|", "looks", "settings", "keys"],
  "left": { "width": 230, "items": ["history", "presets"] },
  "right": {
    "width": 330,
    "items": [
      "histogram",
      {
        "title": "Skin and finish",
        "open": true,
        "columns": 3,
        "items": [
          { "setting": "Texture", "widget": "knob" },
          { "setting": "Clarity2012", "widget": "knob", "label": "Clarity" },
          { "setting": "Dehaze", "widget": "knob" }
        ]
      },
      { "panel": "basic", "open": true, "hide": ["Texture", "Clarity2012", "Dehaze"] },
      { "panel": "detail", "open": true },
      { "panel": "color_mixer" },
      { "panel": "tone_curve" },
      { "panel": "color_grading" },
      { "panel": "effects" },
      { "panel": "lens" },
      { "panel": "transform" },
      { "panel": "black_white" },
      { "panel": "calibration" },
      { "panel": "negative" }
    ]
  }
}

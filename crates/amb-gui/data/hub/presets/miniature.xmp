    amb:Effects="[{&quot;plugin&quot;:&quot;tilt-shift&quot;,&quot;params&quot;:{&quot;position&quot;:60,&quot;band&quot;:15,&quot;blur&quot;:70,&quot;falloff&quot;:30},&quot;amount&quot;:100.0,&quot;seed&quot;:1000}]">
   <crs:Name><rdf:Alt><rdf:li xml:lang="x-default">Miniature</rdf:li></rdf:Alt></crs:Name>
   <crs:Group><rdf:Alt><rdf:li xml:lang="x-default">Wild</rdf:li></rdf:Alt></crs:Group>
   <crs:Description><rdf:Alt><rdf:li xml:lang="x-default">Tilt-shift: a sharp band and blur above and below, with bright toy colours, so a view from high up looks like a model.</rdf:li></rdf:Alt></crs:Description>

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ambrotype",
  "version": "0.1.0",
  "identifier": "org.ambrotype.editor",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Ambrotype",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "backgroundColor": "#1b1c1f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data: https://tile.openstreetmap.org; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"]
  }
}

        <stCamera:RadialDistortParam2>0</stCamera:RadialDistortParam2>
        <stCamera:RadialDistortParam3>0</stCamera:RadialDistortParam3>
        <stCamera:TangentialDistortParam1>0.0001</stCamera:TangentialDistortParam1>
        <stCamera:TangentialDistortParam2>0.0002</stCamera:TangentialDistortParam2>
       </stCamera:ChromaticBlueGreenModel>
       <stCamera:VignetteModel rdf:parseType="Resource">

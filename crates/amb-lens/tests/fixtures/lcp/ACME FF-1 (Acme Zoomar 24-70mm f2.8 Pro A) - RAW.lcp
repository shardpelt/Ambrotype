       <stCamera:RadialDistortParam3>0</stCamera:RadialDistortParam3>
       <stCamera:TangentialDistortParam1>0.001</stCamera:TangentialDistortParam1>
       <stCamera:TangentialDistortParam2>-0.002</stCamera:TangentialDistortParam2>
       <stCamera:ResidualMeanError>0.0001</stCamera:ResidualMeanError>
       <stCamera:ChromaticRedGreenModel rdf:parseType="Resource">
        <stCamera:FocalLengthX>0.6</stCamera:FocalLengthX>
        <stCamera:FocalLengthY>0.6</stCamera:FocalLengthY>

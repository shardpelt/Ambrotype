<!-- Synthetic test preset written for Flightbroom (not a commercial preset). -->
<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="Adobe XMP Core 7.0">
 <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
  <rdf:Description rdf:about=""
    xmlns:crs="http://ns.adobe.com/camera-raw-settings/1.0/">
   <crs:PresetType>Normal</crs:PresetType>
   <crs:SupportsAmount>True</crs:SupportsAmount>
   <crs:ProcessVersion>15.4</crs:ProcessVersion>
   <crs:Exposure2012>-0.20</crs:Exposure2012>
   <crs:ColorGradeShadowHue>220</crs:ColorGradeShadowHue>
   <crs:ColorGradeShadowSat>25</crs:ColorGradeShadowSat>
   <crs:CameraProfile>Adobe Standard</crs:CameraProfile>
   <crs:Name>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Cool Shadows</rdf:li>
     <rdf:li xml:lang="fr-FR">Ombres froides</rdf:li>
    </rdf:Alt>
   </crs:Name>
   <crs:Group>
    <rdf:Alt><rdf:li xml:lang="x-default">Flightbroom Tests</rdf:li></rdf:Alt>
   </crs:Group>
   <crs:MaskGroupBasedCorrections>
    <rdf:Seq>
     <rdf:li>
      <rdf:Description crs:CorrectionAmount="1" crs:LocalExposure2012="0.3" crs:CorrectionName="Sky">
       <crs:CorrectionMasks>
        <rdf:Seq>
         <rdf:li crs:What="Mask/Image" crs:MaskSubType="2" crs:MaskName="Sky"/>
        </rdf:Seq>
       </crs:CorrectionMasks>
      </rdf:Description>
     </rdf:li>
    </rdf:Seq>
   </crs:MaskGroupBasedCorrections>
  </rdf:Description>
 </rdf:RDF>
</x:xmpmeta>

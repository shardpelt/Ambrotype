+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn tmp(name: &str) -> PathBuf {
+        let d = std::env::temp_dir().join(format!("amb-preset-del-{name}-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&d);
+        std::fs::create_dir_all(&d).unwrap();
+        d
+    }
+
+    #[test]
+    fn deletable_only_inside_the_user_folders() {
+        let base = tmp("roots");
+        let own = base.join("own");
+        let other = base.join("other");
+        std::fs::create_dir_all(own.join("Group")).unwrap();
+        std::fs::create_dir_all(&other).unwrap();
+        let inside = own.join("Group/a.xmp");
+        let outside = other.join("b.xmp");
+        let text = own.join("Group/notes.txt");
+        for f in [&inside, &outside, &text] {
+            std::fs::write(f, "x").unwrap();
+        }
+        let roots = canonical_roots(std::slice::from_ref(&own));
+        assert!(
+            preset_deletable(&inside, &roots),
+            "a file in the own folder"
+        );
+        assert!(!preset_deletable(&outside, &roots), "a file outside");
+        let tricky = own.join("Group/../../other/b.xmp");
+        assert!(!preset_deletable(&tricky, &roots), ".. leads out");
+        assert!(!preset_deletable(&text, &roots), "not a preset extension");
+        assert!(!preset_deletable(&own.join("Group"), &roots), "a folder");
+        assert!(!preset_deletable(&own.join("gone.xmp"), &roots), "missing");
+        let _ = std::fs::remove_dir_all(&base);
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn a_link_out_of_the_folder_is_refused() {
+        let base = tmp("link");
+        let own = base.join("own");
+        std::fs::create_dir_all(&own).unwrap();
+        let target = base.join("elsewhere.xmp");
+        std::fs::write(&target, "x").unwrap();
+        let link = own.join("l.xmp");
+        std::os::unix::fs::symlink(&target, &link).unwrap();
+        assert!(!preset_deletable(&link, &canonical_roots(&[own])));
+        let _ = std::fs::remove_dir_all(&base);
+    }
+}

+
+/// Whether a path is a preset file the user may delete: a real file with a
+/// preset extension, inside one of `roots` (canonical paths of the app's
+/// own presets folder and the folders the user added). `..` and symlinks
+/// are resolved first, so they can't lead out.
+pub fn preset_deletable(path: &Path, roots: &[PathBuf]) -> bool {
+    let Ok(real) = std::fs::canonicalize(path) else {
+        return false;
+    };
+    real.is_file() && is_preset_extension(&real) && roots.iter().any(|r| real.starts_with(r))
+}
+
+/// `dirs` as canonical paths, for `preset_deletable`; missing ones drop out.
+pub fn canonical_roots(dirs: &[PathBuf]) -> Vec<PathBuf> {
+    dirs.iter()
+        .filter_map(|d| std::fs::canonicalize(d).ok())
+        .collect()
+}
+
+fn is_preset_extension(p: &Path) -> bool {
+    p.extension()
+        .and_then(|x| x.to_str())
+        .is_some_and(|x| x.eq_ignore_ascii_case("xmp") || x.eq_ignore_ascii_case("lrtemplate"))
 }
 
